{
  "name": "packaging-estimator",
  "version": "0.1.0",
  "description": "Drag in a CAD model, enter a carton, get the best packing orientation, part count, and a 3D view of the packed box.",
  "author": {
    "name": "Logan Bresnahan",
    "email": "loganbbres@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:packaged": "PACKAGED_APP=release/linux-unpacked/packaging-estimator playwright test",
    "e2e:compliance": "playwright test --config playwright.compliance.config.ts",
    "package": "electron-vite build && electron-builder --linux dir"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
